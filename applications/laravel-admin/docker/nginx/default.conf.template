# nginx in front of PHP-FPM. At start, the nginx image replaces ${FPM_HOST} and ${FPM_PORT} with the values of the
# environment variables (envsubst) and writes the result to /etc/nginx/conf.d/default.conf.
#   Kubernetes: both containers run in one Pod, so FPM is on 127.0.0.1 (the default)
#   Compose:    FPM is another container, reached by its service name (FPM_HOST=laravel-fpm)
server {
    listen 8080;
    server_name _;
    root /var/www/html/public;
    index index.php;

    # static files (CSS, images, robots.txt) are answered by nginx itself
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # everything else goes to Laravel's front controller, executed by PHP-FPM over FastCGI
    location ~ \.php$ {
        fastcgi_pass ${FPM_HOST}:${FPM_PORT};
        fastcgi_param SCRIPT_FILENAME /var/www/html/public$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_param HTTP_PROXY "";
        fastcgi_read_timeout 30s;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location ~ /\.(?!well-known) { deny all; }
}
