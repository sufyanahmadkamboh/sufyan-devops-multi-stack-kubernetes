# Configuration of laravel-admin. In containers every value comes from an environment variable (Compose: the
# `environment:` section, Kubernetes: a ConfigMap and a Secret); this file only documents the variables and is the
# template for running the app without containers (copy it to .env, never commit .env).
APP_NAME="Bookshop Reviews"
APP_ENV=local
# Generate your own key: php artisan key:generate --show   (Laravel encrypts cookies and sessions with it)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# logs go to stderr, like every service in this lab (containers log to the console, never to files)
LOG_CHANNEL=stderr
LOG_LEVEL=info

# PostgreSQL. The lab's shared names DB_NAME / DB_USER work as well as Laravel's DB_DATABASE / DB_USERNAME.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bookshop
DB_USERNAME=bookshop
DB_PASSWORD=

# sessions in an encrypted cookie: works with any number of replicas, no shared storage needed
SESSION_DRIVER=cookie
CACHE_STORE=file
QUEUE_CONNECTION=sync
